{
    "name": "magicsunday/xmlmapper",
    "description": "Map PHP to XML",
    "license": "MIT",
    "authors": [
        {
            "name": "Rico Sonntag",
            "email": "mail@ricosonntag.de",
            "role": "Developer",
            "homepage": "https://www.ricosonntag.de/"
        }
    ],
    "support": {
        "issues": "https://github.com/magicsunday/xmlmapper/issues"
    },
    "require": {
        "php": "^8.4",
        "ext-xml": "*",
        "ext-dom": "*",
        "symfony/property-info": "^7.3 || ^8.0",
        "symfony/type-info": "^7.3 || ^8.0",
        "doctrine/inflector": "^2.0"
    },
    "require-dev": {
        "magicsunday/coding-standard": "^3.0",
        "phpdocumentor/reflection-docblock": "^5.0 || ^6.0"
    },
    "suggest": {
        "phpdocumentor/reflection-docblock": "In order to use the PhpDocExtractor this library is required too."
    },
    "autoload": {
        "psr-4": {
            "MagicSunday\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MagicSunday\\Test\\": "tests/"
        }
    },
    "config": {
        "bin-dir": ".build/bin",
        "vendor-dir": ".build/vendor",
        "discard-changes": true,
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": false
    },
    "scripts": {
        "ci:cgl": [
            "php-cs-fixer fix --config .php-cs-fixer.dist.php --diff --verbose"
        ],
        "ci:rector": [
            "rector process --config rector.php"
        ],
        "ci:test:php:cgl": [
            "@ci:cgl --dry-run"
        ],
        "ci:test:php:lint": [
            "phplint --configuration .phplint.yml"
        ],
        "ci:test:php:phpstan": [
            "phpstan analyze --configuration phpstan.neon --memory-limit=-1"
        ],
        "ci:test:php:rector": [
            "@ci:rector --dry-run"
        ],
        "ci:test:php:deptrac": [
            "deptrac analyse --no-progress",
            "deptrac debug:unassigned",
            "@php -r \"is_dir('.build') || mkdir('.build', 0777, true);\"",
            "deptrac analyse --no-progress --formatter=graphviz-dot --output=.build/deptrac-layers.dot",
            "check-deptrac-cycles.php .build/deptrac-layers.dot"
        ],
        "ci:test:php:templates": [
            "check-consumer-config.php ."
        ],
        "ci:test:php:cpd": [
            "npx jscpd --config .jscpd.json --skip-comments --no-tips"
        ],
        "ci:test:php:unit": [
            "phpunit --configuration phpunit.xml"
        ],
        "ci:test:php:unit:coverage": [
            "XDEBUG_MODE=coverage phpunit --configuration phpunit.xml --coverage-html .build/coverage/"
        ],
        "ci:test": [
            "@ci:test:php:lint",
            "@ci:test:php:unit",
            "@ci:test:php:phpstan",
            "@ci:test:php:rector",
            "@ci:test:php:cgl",
            "@ci:test:php:deptrac",
            "@ci:test:php:templates",
            "@ci:test:php:cpd"
        ],
        "post-update-cmd": [
            "npm install jscpd@^5.0.11"
        ]
    }
}
